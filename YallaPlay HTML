  const t0 = AC.currentTime + at; g.gain.setValueAtTime(0, t0); g.gain.linearRampToValueAtTime(0.6, t0 + 0.01); g.gain.setValueAtTime(0.6, t0 + dur - 0.02); g.gain.linearRampToValueAtTime(0, t0 + dur); o.connect(g).connect(AC.destination); o.start(t0); o.stop(t0 + dur + 0.02); }
