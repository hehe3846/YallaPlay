\"id\"], round(s[\"bx\"], 4), round(s[\"by\"], 4), round(s[\"w\"], 4), round(s[\"h\"], 4), 1 if s[\"unsure\"] else 0] for tm, i, p in allp if (s := tracks[tm][\"pos\"][k][i])],\n                    b=[round(balls[k][\"x\"], 4), round(balls[k][\"y\"], 4)] if balls[k] else None) for k, t in enumerate(times)]\n    facts = dict(possession=dict(A=round(tposs[\"A\"], 1), B=round(tposs[\"B\"], 1)), ballVisible=round(seen, 2), players=stats, fps=fps, samples=len(times), detector=\"yolov8n+bytetrack\" if yolo else \"colour\")\n    return F, dict(facts=facts, events=events, limitations=lim, audio=dict(hasAudio=au[\"hasAudio\"], whistles=len(au[\"whistles\"]), cheers=len(au[\"cheers\"]))), overlay\n\n\n# ---------------- dhow ----------------\ndef dhow(path, cfg, au, _):\n    F = Frames(path); fps = cfg.get(\"fps\", 15); lanes = dict(A=cfg[\"laneA\"], B=cfg[\"laneB\"])\n    M = dict(A=matcher(cfg[\"boatA\"], cfg.get(\"tol\", 1)), B=matcher(cfg[\"boatB\"], cfg.get(\"tol\", 1)))\n    u = dict(x=min(lanes[\"A\"][\"x\"], lanes[\"B\"][\"x\"]) - .03, y=min(lanes[\"A\"][\"y\"], lanes[\"B\"][\"y\"]) - .08)\n    u[\"w\"] = max(lanes[\"A\"][\"x\"] + lanes[\"A\"][\"w\"], lanes[\"B\"][\"x\"] + lanes[\"B\"][\"w\"]) + .03 - u[\"x\"]; u[\"h\"] = max(lanes[\"A\"][\"y\"] + lanes[\"A\"][\"h\"], lanes[\"B\"][\"y\"] + lanes[\"B\"][\"h\"]) + .08 - u[\"y\"]\n    d = 1 if cfg[\"finishX\"] >= cfg[\"startX\"] else -1\n    gob = next((b for b in au[\"beeps\"] if b[\"f\"] == 1760), None)\n    go, src = (cfg[\"goManual\"], \"set by host\") if cfg.get(\"goManual\") is not None else ((gob[\"t\"], \"GO beep heard in the audio\") if gob else (None, \"\"))\n    times, boats, motion, prev = [], dict(A=[], B=[]), [], None\n    for t, fr in F.sample(fps):\n        times.append(t); P = planes(fr); ms = {}\n        for tm in \"AB\":\n            m = color_mask(P, M[tm], u, True); ms[tm] = m\n            bl = [b for b in blobs(m, 6) if b[\"area\"] > .0004]\n            boats[tm].append(dict(**{k: bl[0][k] for k in 