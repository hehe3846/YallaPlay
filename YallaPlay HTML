    const stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: "environment" }, audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false } });
    const mime = ["video/webm;codecs=vp9,opus", "video/webm", "video/mp4"].find(m => MediaRecorder.isTypeSupported(m)) || "";
    const rec = new MediaRecorder(stream, mime ? { mimeType: mime } : undefined), chunks = [];
    rec.ondataavailable = e => e.data.size && chunks.push(e.data);
    rec.onstop = () => { stream.getTracks().forEach(t => t.stop()); const blob = new Blob(chunks, { type: rec.mimeType || "video/webm" }); const ext = (rec.mimeType || "").includes("mp4") ? "mp4" : "webm";
      const f = new File([blob], `yalla-turn${G.cur + 1}.${ext}`, { type: blob.type }); REC = { file: f }; if (msg) msg.textContent = `Recorded ${(blob.size / 1e6).toFixed(1)} MB. It will be waiting in the AI judge step.`; };
