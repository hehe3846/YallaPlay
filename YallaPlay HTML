  /* ===================== AL-KARAMAH ===================== */
  async function analyseKaramah(video, cfg, audio, onStage) {
    const fps = cfg.fps || 6, g = makeGrabber(video, 480), dur = video.duration, times = sampleTimes(dur, fps);
    const objs = cfg.objects, M = objs.map(o => makeMatcher(o.color, cfg.tol));
    let start = null, startSrc = "";
    const goBeep = audio.beeps.find(b => b.f === 1760);
    if (cfg.startManual != null) { start = cfg.startManual; startSrc = "set by host"; } else if (goBeep) { start = goBeep.t; startSrc = "start beep heard in the audio"; } else { start = 0; startSrc = "start of the clip (no start beep heard)"; }
    const frac = []; // frac[k][objIdx][zoneIdx]
    onStage(1, 0, "Looking for each hospitality item");
    for (let k = 0; k < times.length; k++) {
      const img = await g.at(times[k]), P = hsvPlanes(img);
      frac[k] = objs.map((o, i) => { const m = mask(P, M[i]); return objs.map(z => countIn(m, g.W, g.H, z.zone)); });
      if (k % 4 === 0) onStage(1, k / times.length, `Looking for each item · frame ${k + 1}/${times.length}`);
    }
    onStage(2, 1, "Checking positions and order");
    const base = objs.map((o, i) => objs.map((z, j) => { const v = frac.slice(0, 3).map(f => f[i][j]); return Math.min(...v); }));
    const events = []; let id = 1; const ev = e => events.push({ id: "e" + id++, ...e, status: "ai" });
    const placed = []; // {obj, zone, t}
    objs.forEach((o, i) => objs.forEach((z, j) => {
      const thr = Math.max(0.08, base[i][j] + 0.07); let run = 0;
      for (let k = 0; k < times.length; k++) { run = frac[k][i][j] > thr ? run + 1 : 0;
        if (run === 3) { const t = times[k - 2]; if (t >= start - 0.3) placed.push({ obj: i, zone: j, t, cov: frac[k][i][j] }); break; } }
    }));
    placed.sort((a, b) => a.t - b.t);
    const correct = [], wrong = [];
    placed.forEach(p => { const o = objs[p.obj], z = objs[p.zone];
      if (p.obj === p.zone) { correct.push(p); ev({ t: +p.t.toFixed(2), type: "placed_ok", obj: o.id, conf: p.cov > 0.2 ? 0.85 : 0.6, reason: `${o.name} colour filled ${Math.round(p.cov * 100)}% of its target spot` }); }
      else { wrong.push(p); ev({ t: +p.t.toFixed(2), type: "placed_wrong", obj: o.id, zone: z.id, conf: p.cov > 0.2 ? 0.75 : 0.5, reason: `${o.name} was put in the ${z.name} spot` }); } });
