  return { A: (sv && sv.A) || (A[r % Math.max(1, A.length)] || {}).id, B: (sv && sv.B) || (B[r % Math.max(1, B.length)] || {}).id }; }
function turns(s) {
  const o = [];
  if (s.game === "football") for (let r = 0; r < s.rules.halves; r++) o.push({ round: r, label: s.rules.halves === 1 ? "Full match" : `Half ${r + 1} of ${s.rules.halves}`, kick: r % 2 ? "B" : "A" });
