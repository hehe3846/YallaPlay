path\")\n    a = ap.parse_args()\n    raw = json.load(open(a.config, encoding=\"utf-8\")); cfg = raw.get(\"config\", raw)\n    if raw.get(\"game\") and raw[\"game\"] != a.game: sys.exit(f\"This config is for {raw['game']}, not {a.game}.\")\n    sha = hashlib.sha256(open(a.video, \"rb\").read()).hexdigest()\n    if raw.get(\"video_sha256\") and raw[\"video_sha256\"] != sha: print(\"Warning: this isn't the same video file that was loaded in the app; the app will refuse the report.\")\n    print(\"Listening to the audio\u2026\"); au = analyse_audio(load_audio(a.video))\n    print(f\"  {len(au['whistles'])} whistle(s), {len(au['beeps'])} beep(s), {len(au['cheers'])} loud moment(s)\" if au[\"hasAudio\"] else \"  no audio (or ffmpeg not found)\")\n    print(\"Watching the video\u2026\")\n    F, out, overlay = {\"football\": football, \"dhow\": dhow, \"karamah\": karamah}[a.game](a.video, cfg, au, a.yolo)\n    report = dict(engine=ENGINE, game=a.game, matchId=raw.get(\"matchId\"), turn=raw.get(\"turn\"), video=dict(name=os.path.basename(a.video), sha256=sha, duration=round(F.duration, 2)),\n                  createdAt=datetime.datetime.now(datetime.timezone.utc).isoformat(), config=cfg, **out)\n    payload = json.dumps(report, ensure_ascii=False, separators=(\",\", \":\"))\n    sig = hmac.new(a.key.encode(), payload.encode(), hashlib.sha256).hexdigest()\n    path = a.out or os.path.splitext(a.video)[0] + \"_yalla_report.json\"\n    json.dump(dict(format=\"yalla-judge-report/1\", payload=payload, sig=sig, overlay=overlay), open(path, \"w\", encoding=\"utf-8\"), ensure_ascii=False)\n    print(f\"\\n{len(out['events'])} game moments found:\")\n    for e in out[\"events\"]: print(f\"  {fmt(e['t'])}  {e['type']:<13} conf {e.get('conf', 1):.2f}  {e.get('reason', '')}\")\n    print(f\"\\nSigned report written to {path}\\nImport it in the app's AI judge step (Use the Python AI judge \u2192 Import).\")\n\n\nif __name__ == \"__main__\":\n    main()\n", "readme": "# Yalla Play! Python AI judge\n\nThe second way to connect the AI judge: process the video on a laptop and import a signed report into the app.\n\n## Install\n\n```\npip install opencv-python numpy\npip install ultralytics      # optional, football only: YOLOv8n person + ball detection with ByteTrack\n```\n\nInstall ffmpeg too (https://ffmpeg.org). The judge uses it to read the sound track for whistles and the GO beep. Without it, the video is still judged but sound is skipped.\n\n## Run\n\n1. In the app, open the AI judge step, add the video, and mark the goals / lanes / tray spots.\n2. Open **Use the Python AI judge instead**, note the judge code (e.g. `YP-ABCD-1234`) and download `yalla_config.json`.\n3. Run:\n\n```\npython yalla_judge.py football match.mp4 --config yalla_config.json --key YP-ABCD-1234\npython yalla_judge.py football match.mp4 --config yalla_config.json --key YP-ABCD-1234 --yolo\npython yalla_judge.py dhow race1.mp4 --config yalla_config.json --key YP-ABCD-1234\npython yalla_judge.py karamah turn1.mp4 --config yalla_config.json --key YP-ABCD-1234\n```\n\n4. Import the `*_yalla_report.json` it writes, using the same step in the app.\n\n## How the app knows the report is genuine\n\nThe report's `payload` is signed with HMAC-SHA256 using the judge code as the key. The app recomputes the signature and refuses the report if a single character was changed. It also compares the SHA-256 fingerprint of the video in the report with the video loaded in the app.\n"};
