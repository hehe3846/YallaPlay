    const lane = (blob) => ({ x: 0, y: +Math.max(0, (blob === top ? mid - h : mid)).toFixed(4), w: 1, h: +Math.min(h, 1).toFixed(4) });
    c[a === top ? "laneA" : "laneB"] = lane(top); c[a === top ? "laneB" : "laneA"] = lane(bot); c.startX = +Math.max(a.x + a.w, b.x + b.w).toFixed(4);
    toast("Lanes and start line found from the boats. Now click where the finish line is."); AN.tool = toolsList().find(t => t[0] === "finishX"); }
  if (G.game === "football") { const found = ["A", "B"].map(t => YE.blobs(YE.dilate(YE.mask(P, YE.makeMatcher(G.teams[t].color, 1)), g.W, g.H), g.W, g.H, 3).filter(b => b.area > 0.0004).length);
    toast(`Found ${found[0]} ${G.teams.A.name} and ${found[1]} ${G.teams.B.name} shirts in this frame. Mark the goals, then tag each player.`); }
  save(); renderTools(); refreshSide();
}

route();

</script>
