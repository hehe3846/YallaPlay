/* ---------- scoring (pure functions of applied results) ---------- */
function footballRound(s, res) {
  const sc = { A: 0, B: 0 }, goals = [];
  for (const e of res.events) if (e.type === "goal" && counts(e) && e.team) { sc[e.team] += s.rules.goalPts; goals.push(e); }
  return { sc, goals };
}
function dhowRound(s, res) {
  const out = {}; const b = res.facts.boats || {};
  for (const t of ["A", "B"]) { const raw = res.override && res.override[t] != null ? res.override[t] : b[t] && b[t].raw;
    const pens = res.events.filter(e => e.team === t && ["false_start", "touch", "lane"].includes(e.type) && counts(e));
    const pen = pens.reduce((a, e) => a + (+e.pen || 0), 0); out[t] = { raw, pen, adj: raw == null ? null : +(raw + pen).toFixed(2), pens }; }
  let winner = null, why = "";
  if (out.A.adj == null && out.B.adj == null) why = "Inconclusive: neither finish was seen. Rerun the race.";
  else if (out.A.adj == null) { winner = "B"; why = `${s.teams.A.name} didn't finish`; }
  else if (out.B.adj == null) { winner = "A"; why = `${s.teams.B.name} didn't finish`; }
  else if (Math.abs(out.A.adj - out.B.adj) < 0.01) { if (out.A.pen !== out.B.pen) { winner = out.A.pen < out.B.pen ? "A" : "B"; why = "Dead heat on adjusted time; fewer penalties wins"; } else why = "Dead heat. Rerun the race."; }
  else { winner = out.A.adj < out.B.adj ? "A" : "B"; why = `adjusted time ${out[winner].adj.toFixed(2)}s vs ${out[winner === "A" ? "B" : "A"].adj.toFixed(2)}s`; }
  return { ...out, winner, why };
}
function karamahTurn(s, res) {
  const R = s.rules, need = R.objects.map(o => o.id), ok = new Set(), wrong = [];
  const placedOk = res.events.filter(e => e.type === "placed_ok" && counts(e)).sort((a, b) => a.t - b.t);
  placedOk.forEach(e => ok.add(e.obj));
  res.events.filter(e => e.type === "placed_wrong" && counts(e)).forEach(e => wrong.push(e));
  const order = []; placedOk.forEach(e => { if (!order.includes(e.obj)) order.push(e.obj); });
  const requireOrder = R.difficulty !== "easy";
  const seqOk = order.length === need.length && order.every((o, i) => o === need[i]);
  const compl = res.override && res.override.completion != null ? res.override.completion : res.facts.completion;
  const inTime = compl != null && ok.size === need.length && compl <= R.limit;
  let pts = ok.size * R.ptsPos - wrong.length * R.penWrong; const lines = [`${ok.size}/${need.length} items in the right spot: +${ok.size * R.ptsPos}`];
  if (wrong.length) lines.push(`${wrong.length} wrong spot${wrong.length > 1 ? "s" : ""}: −${wrong.length * R.penWrong}`);
  if (requireOrder) { if (seqOk) { pts += R.ptsSeq; lines.push(`correct serving order: +${R.ptsSeq}`); } else if (order.length) { pts -= R.penSeq; lines.push(`serving order ${order.map(o => objName(s, o)).join(" → ")} (wanted ${need.map(o => objName(s, o)).join(" → ")}): −${R.penSeq}`); } }
  if (inTime) { pts += R.ptsTime; lines.push(`finished in ${compl.toFixed(1)}s (limit ${R.limit}s): +${R.ptsTime}`); } else if (compl != null) lines.push(`time ${compl.toFixed(1)}s`);
  return { pts, lines, compl: compl ?? null, accuracy: ok.size / need.length, order, seqOk, wrong: wrong.length };
}
const objName = (s, id) => (s.rules.objects.find(o => o.id === id) || { name: id }).name;

function totals(s) {
  const T = turns(s), res = s.results;
  if (s.game === "football") { const sc = { A: 0, B: 0 }; res.forEach(r => { if (!r) return; const x = footballRound(s, r); sc.A += x.sc.A; sc.B += x.sc.B; }); return { sc }; }
  if (s.game === "dhow") { const wins = { A: 0, B: 0 }; res.forEach(r => { if (!r) return; const x = dhowRound(s, r); if (x.winner) wins[x.winner]++; }); return { sc: wins }; }
  const pts = {}, time = {}; s.players.forEach(p => { pts[p.id] = 0; time[p.id] = 0; });
  res.forEach((r, i) => { if (!r) return; const x = karamahTurn(s, r); pts[T[i].pid] += x.pts; time[T[i].pid] += x.compl ?? s.rules.limit; });
  const sc = { A: 0, B: 0 }; if (s.mode === "team") s.players.forEach(p => { if (p.team) sc[p.team] += pts[p.id]; });
  return { pts, time, sc };
}
function matchOver(s) { const T = turns(s); if (s.cur >= T.length) return true;
  if (s.game === "dhow") { const need = Math.floor(s.rules.rounds / 2) + 1, w = totals(s).sc; return w.A >= need || w.B >= need; } return false; }

