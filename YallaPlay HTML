window.YALLA_JUDGE = {"py": "#!/usr/bin/env python3\n\"\"\"\nYalla Play! - Python AI judge\n==============================\nProcesses a game video (with its audio) and writes a signed judge report that the\nYalla Play! app can import. The app checks the HMAC-SHA256 signature with your\nmatch's judge code, and checks the video fingerprint, before it applies anything.\n\n  pip install opencv-python numpy            (required)\n  pip install ultralytics                    (optional: YOLO person/ball detection + ByteTrack)\n  ffmpeg on PATH                             (optional: needed for whistle / GO-beep detection)\n\n  python yalla_judge.py football match.mp4 --config yalla_config.json --key YP-ABCD-1234\n  python yalla_judge.py dhow race1.mp4 --config yalla_config.json --key YP-ABCD-1234\n  python yalla_judge.py karamah turn.mp4 --config yalla_config.json --key YP-ABCD-1234 [--yolo]\n\nGet yalla_config.json from the app's AI judge step (\"Download yalla_config.json\") after\nmarking the goals / lanes / tray spots. It holds the same markings the in-browser judge uses.\n\"\"\"\nimport argparse, hashlib, hmac, json, math, os, shutil, subprocess, sys, datetime\nimport numpy as np\nimport cv2\n\nENGINE = \"yalla-python-cv 1.0\"\n\n\ndef fmt(t):\n    if t is None: return \"--:--\"\n    m = int(t // 60); return f\"{m:02d}:{t - m * 60:04.1f}\"\n\n\n# ---------------- colour ----------------\ndef hex_rgb(h): n = int(h.lstrip(\"#\"), 16); return ((n >> 16) & 255, (n >> 8) & 255, n & 255)\n\n\ndef rgb_hsv(r, g, b):\n    import colorsys\n    h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255); return h * 360, s, v\n\n\ndef matcher(hexc, tol=1.0):\n    th, ts, tv = rgb_hsv(*hex_rgb(hexc))\n    def f(H, S, V):\n        if ts < 0.22: return (S < 0.2 + 0.05 * tol) & (np.abs(V - tv) < 0.13 * tol)\n        d = np.abs(H - th); d = np.minimum(d, 360 - d)\n        return (d < 16 * tol) & (S > max(0.3, ts * 0.55)) & (V > max(0.18, tv * 0.4))\n    return f\n\n\ndef planes(bgr):\n    hsv = cv2.cvtColor(bgr, cv2.COLOR_BGR2HSV_FULL).astype(np.float32)\n    return hsv[..., 0] * (360 / 256), hsv[..., 1] / 255, hsv[..., 2] / 255\n\n\ndef roi_mask(shape, roi):\n    Hh, W = shape; m = np.zeros(shape, bool)\n    if roi is None: m[:] = True; return m\n    x0, x1 = max(0, int(math.floor(roi[\"x\"] * W))), min(W, int(math.ceil((roi[\"x\"] + roi[\"w\"]) * W)))\n    y0, y1 = max(0, int(math.floor(roi[\"y\"] * Hh))), min(Hh, int(math.ceil((roi[\"y\"] + roi[\"h\"]) * Hh)))\n    m[y0:y1, x0:x1] = True; return m\n\n\ndef color_mask(P, f, roi=None, dil=False):\n    m = f(*P) & roi_mask(P[0].shape, roi)\n    m = m.astype(np.uint8)\n    if dil: m = cv2.dilate(m, cv2.getStructuringElement(cv2.MORPH_CROSS, (3, 3)))\n    return m\n\n\ndef blobs(m, min_px=4):\n    Hh, W = m.shape\n    n, lab, st, cen = cv2.connectedComponentsWithStats(m, connectivity=4)\n    out = []\n    for i in range(1, n):\n        x, y, w, h, a = st[i]\n        if a < min_px: continue\n        out.append(dict(cx=cen[i][0] / W, cy=cen[i][1] / Hh, x=x / W, y=y / Hh, w=w / W, h=h / Hh, area=a / (W * Hh), pw=w, ph=h, fill=a / (w * h)))\n    return sorted(out, key=lambda b: -b[\"area\"])\n\n\ndef count_in(m, r):\n    Hh, W = m.shape\n    x0, x1 = max(0, int(math.floor(r[\"x\"] * W))), min(W, int(math.ceil((r[\"x\"] + r[\"w\"]) * W)))\n    y0, y1 = max(0, int(math.floor(r[\"y\"] * Hh))), min(Hh, int(math.ceil((r[\"y\"] + r[\"h\"]) * Hh)))\n    sub = m[y0:y1, x0:x1]; return float(sub.mean()) if sub.size else 0.0\n\n\ndef in_rect(r, x, y, pad=0): return r[\"x\"] - pad <= x <= r[\"x\"] + r[\"w\"] + pad and r[\"y\"] - pad <= y <= r[\"y\"] + r[\"h\"] + pad\n\n\n# ---------------- video ----------------\nclass Frames:\n    def __init__(self, path, width=480):\n        self.cap = cv2.VideoCapture(path)\n        if not self.cap.isOpened(): sys.exit(f\"Can't open video: {path}\")\n        self.fps = self.cap.get(cv2.CAP_PROP_FPS) or 25\n        n = self.cap.get(cv2.CAP_PROP_FRAME_COUNT)\n        self.duration = n / self.fps if n > 0 else 0\n        w, h = self.cap.get(cv2.CAP_PROP_FRAME_WIDTH), self.cap.get(cv2.CAP_PROP_FRAME_HEIGHT)\n        self.size = (width, max(2, round(width * h / w)))\n\n    def sample(self, fps):\n        \"\"\"Decode sequentially, yielding (t, frame) at ~fps samples per second.\"\"\"\n        step, nxt, k = 1 / fps, 0.0, 0\n        self.cap.set(cv2.CAP_PROP_POS_FRAMES, 0)\n        while True:\n            ok, fr = self.cap.read()\n            if not ok: break\n            t = k / self.fps; k += 1\n            if t + 1e-6 >= nxt:\n                nxt += step\n                yield round(t, 3), cv2.resize(fr, self.size, interpolation=cv2.INTER_AREA)\n\n\n# ---------------- audio ----------------\ndef load_audio(path, sr=22050):\n    if not shutil.which(\"ffmpeg\"): return None\n    p = subprocess.run([\"ffmpeg\", \"-v\", \"error\", \"-i\", path, \"-vn\", \"-ac\", \"1\", \"-ar\", str(sr), \"-f\", \"f32le\", \"-\"], capture_output=True)\n    if p.returncode or not p.stdout: return None\n    return np.frombuffer(p.stdout, np.float32), sr\n\n\ndef analyse_audio(a):\n    if a is None: return dict(hasAudio=False, whistles=[], beeps=[], cheers=[])\n    x, sr = a; N, hop = 1024, 512\n    nf = (len(x) - N) // hop\n    if nf <= 0: return dict(hasAudio=False, whistles=[], beeps=[], cheers=[])\n    idx = np.arange(N)[None, :] + hop * np.arange(nf)[:, None]\n    fr = x[idx]; rms = np.sqrt((fr ** 2).mean(1))\n    mag = np.abs(np.fft.rfft(fr * np.hanning(N), axis=1))[:, :N // 2]\n    b = lambda f: int(round(f * N / sr))\n    band = mag[:, b(300):min(N // 2 - 1, b(8000)) + 1]\n    mean = band.mean(1) + 1e-9; flat = np.exp(np.log(band + 1e-9).mean(1)) / mean\n    wh = (mag[:, b(2000):b(4500) + 1].max(1) / mean > 14) & (rms > 0.01)\n    bp = [((np.max(mag[:, b(f) - 1:b(f) + 2], 1) / mean) > 18) & (rms > 0.01) for f in (880, 1760)]\n    fdt = hop / sr\n\n    def segs(arr, mind, gap=2):\n        out, s, last = [], -1, -1\n        for f in range(len(arr) + 1):\n            if f < len(arr) and arr[f]:\n                if s < 0: s = f\n                last = f\n            elif s >= 0 and f - last > gap:\n                if (last - s + 1) * fdt >= mind: out.append(dict(t=round(s * fdt, 2), dur=round((last - s + 1) * fdt, 2)))\n                s = -1\n        return out\n    med = float(np.median(rms))\n    loud = (rms > max(0.03, med * 3)) & (flat > 0.25)\n    beeps = [dict(**s, f=880) for s in segs(bp[0], 0.1)] + [dict(**s, f=1760) for s in segs(bp[1], 0.25)]\n    return dict(hasAudio=True, whistles=segs(wh, 0.2), beeps=sorted(beeps, key=lambda s: s[\"t\"]), cheers=segs(loud, 0.8, 6), medianRms=round(med, 4))\n\n\n# ---------------- tracking ----------------\ndef assign(cost):\n    n = len(cost); m = len(cost[0]) if n else 0\n    best, bestc = [-1] * n, [1e18]\n    if n <= 6 and m <= 8:\n        used, cur = [False] * m, [-1] * n\n        def rec(i, c):\n            if c >= bestc[0]: return\n            if i == n: bestc[0] = c; best[:] = cur; return\n            cur[i] = -1; rec(i + 1, c + 1e3)\n            for j in range(m):\n                if not used[j] and cost[i][j] < 1e3:\n                    used[j] = True; cur[i] = j; rec(i + 1, c + cost[i][j]); used[j] = False\n            cur[i] = -1\n        rec(0, 0); return best\n    pairs = sorted((cost[i][j], i, j) for i in range(n) for j in range(m) if cost[i][j] < 1e3)\n    out, ui, uj = [-1] * n, set(), set()\n    for _, i, j in pairs:\n        if i not in ui and j not in uj: out[i] = j; ui.add(i); uj.add(j)\n    return out\n\n\ndef track_team(times, dets, n, seed_idx, seeds):\n    S = len(times); res = [[None] * n for _ in range(S)]; meta = [dict(reacq=[]) for _ in range(n)]\n    def run(order):\n        st = [dict(x=s[\"x\"], y=s[\"y\"], vx=0, vy=0, lastT=times[seed_idx], seen=True) for s in seeds]\n        for k in order:\n            t, D = times[k], dets[k]\n            cost = []\n            for s in st:\n                gap = abs(t - s[\"lastT\"]); px, py = s[\"x\"] + s[\"vx\"] * min(gap, .5), s[\"y\"] + s[\"vy\"] * min(gap, .5)\n                gate = 0.07 + 0.22 * min(gap, 2)\n                cost.append([(lambda d: d if d < gate else 1e3)(math.hypot(d[\"cx\"] - px, (d[\"cy\"] - py) * .75)) for d in D])\n            mt = assign(cost) if D else [-1] * len(st)\n            fwd = 1 if k >= seed_idx else -1\n            for i, s in enumerate(st):\n                j = mt[i]\n                if j >= 0:\n                    d = D[j]; gap = abs(t - s[\"lastT\"]) or 1e-3; re = (not s[\"seen\"]) and gap > 1.5\n                    if re: meta[i][\"reacq\"].append(round(t, 2))\n                    s[\"vx\"] = (d[\"cx\"] - s[\"x\"]) / gap * fwd * .5 + s[\"vx\"] * .5; s[\"vy\"] = (d[\"cy\"] - s[\"y\"]) / gap * fwd * .5 + s[\"vy\"] * .5\n                    s.update(x=d[\"cx\"], y=d[\"cy\"], lastT=t, seen=True)\n                    res[k][i] = dict(x=d[\"cx\"], y=d[\"cy\"], w=d[\"w\"], h=d[\"h\"], bx=d[\"x\"], by=d[\"y\"], unsure=re)\n                else:\n                    s[\"seen\"] = False; s[\"vx\"] *= .5; s[\"vy\"] *= .5\n    run(range(seed_idx, S)); run(range(seed_idx - 1, -1, -1))\n    return res, meta\n\n\n# ---------------- football ----------------\ndef colour_groups(players, teams):\n    \"\"\"Family football: everyone may wear different clothes. Players in similar colours share a\n    group; inside a group the slot tracker tells them apart by movement.\"\"\"\n    groups = []\n    for p in players:\n        col = p.get(\"color\") or teams[p[\"team\"]][\"color\"]; h, s, v = rgb_hsv(*hex_rgb(col))\n        for g in groups:\n            gh, gs, gv = g[\"hsv\"]\n            same = (gs < .22 and s < .22 and abs(gv - v) < .15) if (gs < .22 or s < .22) else min(abs(gh - h), 360 - abs(gh - h)) < 18\n            if same: g[\"members\"].append(p); break\n        else: groups.append(dict(key=f\"g{len(groups)}\", color=col, hsv=(h, s, v), members=[p]))\n    return groups\n\n\ndef football(path, cfg, au, use_yolo):\n    F = Frames(path); fps = cfg.get(\"fps\", 8)\n    groups = colour_groups(cfg[\"players\"], cfg[\"teams\"]); keys = [g[\"key\"] for g in groups]\n    M = {g[\"key\"]: matcher(g[\"color\"], cfg.get(\"tol\", 1)) for g in groups}\n    ballM = matcher(cfg[\"ballColor\"], cfg.get(\"tol\", 1)); pitch = cfg.get(\"pitch\") or dict(x=0, y=0, w=1, h=1)\n    roi = dict(x=pitch[\"x\"] - .04, y=pitch[\"y\"] - .08, w=pitch[\"w\"] + .08, h=pitch[\"h\"] + .12)\n    minA = cfg.get(\"minPlayerArea\", 0.0005)\n    yolo = None\n    if use_yolo:\n        try:\n            from ultralytics import YOLO; yolo = YOLO(\"yolov8n.pt\"); print(\"Using YOLOv8n + ByteTrack for people and the ball\")\n        except Exception as e: print(\"YOLO not available, using colour detection:\", e)\n    times, dets, balls, last = [], {k: [] for k in keys}, [], None\n    for t, fr in F.sample(fps):\n        times.append(t); P = planes(fr)\n        if yolo is not None:\n            r = yolo.track(fr, persist=True, tracker=\"bytetrack.yaml\", classes=[0, 32], verbose=False)[0]\n            Hh, W = fr.shape[:2]; per = {k: [] for k in keys}; bl = None\n            for (x0, y0, x1, y1), c in zip(r.boxes.xyxy.cpu().numpy(), r.boxes.cls.cpu().numpy()):\n                if int(c) == 32: bl = dict(x=(x0 + x1) / 2 / W, y=(y0 + y1) / 2 / Hh); continue\n                ty0, ty1 = int(y0 + (y1 - y0) * .15), int(y0 + (y1 - y0) * .5)   # upper-body band\n                sub = [p[ty0:ty1, int(x0):int(x1)] for p in P]\n                if sub[0].size == 0: continue\n                frac = {k: float(M[k](*sub).mean()) for k in keys}\n                k = max(frac, key=frac.get)\n                if frac[k] < .15: continue\n                tx0, tw = x0 / W, (x1 - x0) / W\n                per[k].append(dict(cx=(x0 + x1) / 2 / W, cy=(ty0 + ty1) / 2 / Hh, x=tx0, y=ty0 / Hh, w=tw, h=(ty1 - ty0) / Hh, area=tw * (ty1 - ty0) / Hh))\n            for k in keys: dets[k].append(per[k])\n            if bl is None:\n                c = [b for b in blobs(color_mask(P, ballM, roi), 2) if b[\"area\"] < .004 and b[\"fill\"] > .4 and .5 < b[\"pw\"] / b[\"ph\"] < 2]\n                bl = dict(x=c[0][\"cx\"], y=c[0][\"cy\"]) if c else None\n            balls.append(bl); continue\n        for k in keys:\n            dets[k].append([b for b in blobs(color_mask(P, M[k], roi, True), 3) if minA <= b[\"area\"] < .08 and b[\"fill\"] > .25 and .4 < b[\"ph\"] / b[\"pw\"] < 5])\n        c = [b for b in blobs(color_mask(P, ballM, roi), 2) if b[\"area\"] < .004 and b[\"fill\"] > .4 and .5 < b[\"pw\"] / b[\"ph\"] < 2]\n        if last and len(c) > 1: c.sort(key=lambda b: math.hypot(b[\"cx\"] - last[\"cx\"], b[\"cy\"] - last[\"cy\"]))\n        balls.append(dict(x=c[0][\"cx\"], y=c[0][\"cy\"]) if c else None)\n        if c: last = c[0]\n        if len(times) % 40 == 0: print(f\"  frame sample {len(times)} at {fmt(t)}\")\n    players = cfg[\"players\"]; tracks, lim = {}, []\n    for g in groups:\n        tm, roster = g[\"key\"], g[\"members\"]; n = len(roster); ids = {p[\"id\"] for p in roster}\n        tags = [x for x in cfg.get(\"tags\", []) if x[\"pid\"] in ids]\n        if tags:\n            tref = tags[0][\"t\"]; si = min(range(len(times)), key=lambda i: abs(times[i] - tref))\n            seeds = []\n            for i, p in enumerate(roster):\n                tg = next((x for x in tags if x[\"pid\"] == p[\"id\"]), None)\n                seeds.append(dict(x=tg[\"x\"], y=tg[\"y\"]) if tg else dict(x=.2 + .6 * i / max(1, n - 1), y=.5))\n        else:\n            si = next((i for i, d in enumerate(dets[tm]) if len(d) >= n), 0)\n            seeds = [dict(x=d[\"cx\"], y=d[\"cy\"]) for d in sorted(dets[tm][si][:n], key=lambda d: d[\"cx\"])] if dets[tm] else []\n            while len(seeds) < n: seeds.append(dict(x=.5, y=.5))\n            lim.append(f\"{', '.join(p['name'] for p in roster)} weren't clicked in the app, so identities were guessed at {fmt(times[si])}.\")\n        if n > 1: lim.append(f\"{' and '.join(p['name'] for p in roster)} wear similar colours; told apart by movement. Check identity when they cross.\")\n        pos, meta = track_team(times, dets[tm], n, si, seeds); tracks[tm] = dict(roster=roster, pos=pos, meta=meta)\n    allp = [(g[\"key\"], i, p) for g in groups for i, p in enumerate(tracks[g[\"key\"]][\"roster\"])]\n    stats = {p[\"id\"]: dict(pid=p[\"id\"], possession=0, touches=0, passes=0, passesRecv=0, wins=0, goals=0, assists=0, reacq=tracks[tm][\"meta\"][i][\"reacq\"]) for tm, i, p in allp}\n    dt = 1 / fps; poss = []\n    for k in range(len(times)):\n        b = balls[k]; best, bd = None, 1e9\n        bp_, bn_ = balls[k - 1] if k else None, balls[k + 1] if k + 1 < len(balls) else None\n        bv = ((bn_[\"x\"] - bp_[\"x\"]) * fps / 2, (bn_[\"y\"] - bp_[\"y\"]) * fps / 2) if bp_ and bn_ else None\n        if b:\n            for tm, i, p in allp:\n                s = tracks[tm][\"pos\"][k][i]\n                if not s: continue\n                if bv:\n                    sp = tracks[tm][\"pos\"][k - 1][i] if k else None; sn = tracks[tm][\"pos\"][k + 1][i] if k + 1 < len(times) else None\n                    pv = ((sn[\"x\"] - sp[\"x\"]) * fps / 2, (sn[\"y\"] - sp[\"y\"]) * fps / 2) if sp and sn else (0, 0)\n                    if math.hypot(bv[0] - pv[0], (bv[1] - pv[1]) * .6) > .15: continue\n                d = math.hypot(b[\"x\"] - s[\"x\"], b[\"y\"] - (s[\"y\"] + s[\"h\"] * .4))\n                if d < max(.05, s[\"h\"] * 1.7) and d < bd: bd, best = d, p[\"id\"]\n        poss.append(best)\n    holder = [p if p and ((k and poss[k - 1] == p) or (k + 1 < len(poss) and poss[k + 1] == p)) else None for k, p in enumerate(poss)]\n    team_of = {p[\"id\"]: p[\"team\"] for tm, i, p in allp}; tposs = dict(A=0, B=0); spells, prev, prevT = [], None, -1e9\n    for k, h in enumerate(holder):\n        if not h: continue\n        stats[h][\"possession\"] += dt; tposs[team_of[h]] += dt\n        if h != prev:\n            stats[h][\"touches\"] += 1\n            if prev and times[k] - prevT < 4:\n                if team_of[prev] == team_of[h]: stats[prev][\"passes\"] += 1; stats[h][\"passesRecv\"] += 1\n                else: stats[h][\"wins\"] += 1\n            spells.append(dict(pid=h, t=times[k]))\n        prev, prevT = h, times[k]\n    L, Wm = cfg.get(\"pitchLen\", 20), cfg.get(\"pitchWid\", 12)\n    for tm, i, p in allp:\n        P_ = tracks[tm][\"pos\"]; d = tr = 0\n        for k in range(1, len(times)):\n            s0, s1 = P_[k - 1][i], P_[k][i]\n            if s1: tr += dt\n            if s0 and s1:\n                st = math.hypot((s1[\"x\"] - s0[\"x\"]) / pitch[\"w\"] * L, (s1[\"y\"] - s0[\"y\"]) / pitch[\"h\"] * Wm)\n                if st < 9 * dt: d += st\n        stats[p[\"id\"]].update(distM=round(d, 1), tracked=round(tr, 1), possession=round(stats[p[\"id\"]][\"possession\"], 2))\n    events = []\n    def ev(**e): events.append(dict(id=f\"e{len(events) + 1}\", status=\"ai\", **e))\n    name = lambda pid: next((p[\"name\"] for p in players if p[\"id\"] == pid), pid)\n    goals = [dict(rect=cfg[k], defends=d) for k, d in ((\"goalA\", \"A\"), (\"goalB\", \"B\")) if cfg.get(k)]\n    lock = -1\n    for k in range(1, len(times)):\n        if times[k] < lock:\n            if balls[k] and any(in_rect(g[\"rect\"], balls[k][\"x\"], balls[k][\"y\"], .01) for g in goals): lock = times[k] + 2\n            continue\n        for g in goals:\n            b0, b1 = balls[k - 1], balls[k]\n            if b0 and b1 and in_rect(g[\"rect\"], b0[\"x\"], b0[\"y\"], .005) and in_rect(g[\"rect\"], b1[\"x\"], b1[\"y\"], .005):\n                tg, scoring = times[k - 1], \"B\" if g[\"defends\"] == \"A\" else \"A\"\n                inside = 0; j = k - 1\n                while j < len(times) and balls[j] and in_rect(g[\"rect\"], balls[j][\"x\"], balls[j][\"y\"], .01): inside += 1; j += 1\n                approach = sum(1 for j in range(k - 2, -1, -1) if times[j] > tg - 1.5 and balls[j])\n                recent = [s for s in spells if tg - 5 < s[\"t\"] <= tg]; last_s = recent[-1] if recent else None\n                scorer = assist = None; own = False; why = []\n                if last_s and team_of[last_s[\"pid\"]] == scoring:\n                    scorer = last_s[\"pid\"]; si = spells.index(last_s); pv = spells[si - 1] if si else None\n                    if pv and pv[\"pid\"] != scorer and team_of[pv[\"pid\"]] == scoring and last_s[\"t\"] - pv[\"t\"] < 8: assist = pv[\"pid\"]\n                elif last_s: own = True\n                aud = [s for s in au[\"whistles\"] + au[\"cheers\"] if tg - .5 <= s[\"t\"] <= tg + 4]\n                c = .55 + (.15 if approach >= 3 else 0) + (.15 if inside >= 3 else 0) + (.1 if aud else 0)\n                why.append(f\"ball tracked into {cfg['teams'][g['defends']]['name']}'s goal and stayed in for {inside / fps:.1f}s\")\n                why.append(\"ball seen on its way in\" if approach >= 3 else \"ball barely seen on approach\")\n                if aud: why.append(f\"sound heard {aud[0]['t'] - tg:.1f}s later\")\n                if own: why.append(\"last touch by the defending team, possible own goal\"); c = min(c, .7)\n                ev(t=round(tg, 2), type=\"goal\", team=scoring, pid=scorer, assist=assist, conf=round(min(.98, c), 2), reason=\"; \".join(why))\n                if scorer: stats[scorer][\"goals\"] += 1\n                if assist: stats[assist][\"assists\"] += 1\n                lock = tg + 3; break\n    outlock = -1\n    for k in range(1, len(times)):\n        b0, b1 = balls[k - 1], balls[k]\n        if not b0 or not b1 or times[k] < outlock: continue\n        out = lambda b: not in_rect(pitch, b[\"x\"], b[\"y\"], .005) and not any(in_rect(g[\"rect\"], b[\"x\"], b[\"y\"], .02) for g in goals)\n        if out(b0) and out(b1):\n            ls = [s for s in spells if s[\"t\"] <= times[k]]; ls = ls[-1] if ls else None\n            ev(t=round(times[k - 1], 2), type=\"out\", team=team_of[ls[\"pid\"]] if ls else None, pid=ls[\"pid\"] if ls else None, conf=.6, reason=\"ball left the marked 