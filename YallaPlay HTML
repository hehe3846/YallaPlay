  if (s.game === "dhow") for (let r = 0; r < s.rules.rounds; r++) o.push({ round: r, label: `Race ${r + 1} of ${s.rules.rounds} (best of ${s.rules.rounds})`, sailors: sailorsFor(s, r) });
