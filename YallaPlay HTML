function startClock(limit) { stopClock(); const t0 = performance.now(); const el = () => $("#clock");
  CLOCK = setInterval(() => { const left = limit - (performance.now() - t0) / 1000; if (!el()) return stopClock(); el().textContent = mmss(left); el().classList.toggle("low", left <= 10);
    if (left <= 0) { stopClock(); beep(440, 0.9); el().textContent = "TIME!"; } }, 200); }
