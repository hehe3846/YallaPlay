function route(keep) {
  const h = (location.hash || "#home").slice(1);
  document.querySelectorAll(".nav a").forEach(a => a.classList.toggle("on", a.getAttribute("href") === "#" + h || (h === "play" && a.getAttribute("href") === "#home")));
  stopRec(); if (AN && AN.raf) cancelAnimationFrame(AN.raf);
  const app = $("#app");
  if (h === "play" && G) app.innerHTML = rail() + viewStep();
  else if (h === "how") app.innerHTML = viewHow();
  else if (h === "previous") app.innerHTML = viewPrevious();
  else if (h === "about") app.innerHTML = viewAbout();
  else app.innerHTML = viewHome();
  mount(h);
  window.scrollTo({ top: keep === true ? KEEP_Y : 0 });
}
window.addEventListener("hashchange", () => route());
let KEEP_Y = 0;
