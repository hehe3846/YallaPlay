(1, len(times)):\n            if times[k] < lock: continue\n            m = motion[k][tm]\n            if m > .15 or (m > .1 and m + motion[k - 1][tm] > .25):\n                ev(t=times[k - 1], type=\"touch\", team=tm, pen=cfg[\"pen\"][\"touch\"], conf=.5, reason=f\"something other than the boat moved right next to it ({round(m * 100)}% of boat size). Could be a hand, so check the replay.\"); lock = times[k] + 1.5\n        fin = None\n        for k in range(1, len(times)):\n            a, b = B[k - 1], B[k]\n            if a and b and (a[\"front\"] - cfg[\"finishX\"]) * d < 0 <= (b[\"front\"] - cfg[\"finishX\"]) * d:\n                uu = (cfg[\"finishX\"] - a[\"front\"]) / ((b[\"front\"] - a[\"front\"]) or 1e-6); fin = times[k - 1] + uu * (times[k] - times[k - 1]); break\n        res[tm] = dict(finish=round(fin, 2) if fin is not None else None, raw=round(fin - go, 2) if fin is not None and go is not None else None, visible=round(sum(1 for b in B if b) / max(1, len(B)), 2))\n        if fin is not None: ev(t=round(fin, 2), type=\"finish\", team=tm, conf=.9, reason=\"front of the boat crossed the finish line\" + (f\"; {fin - go:.2f}s after GO\" if go is not None else \"\"))\n    if go is not None: ev(t=go, type=\"go\", conf=.9 if src.startswith(\"GO\") else 1, reason=f\"official start: {src}\")\n    events.sort(key=lambda e: e[\"t\"]); lim = []\n    if go is None: lim.append(\"No GO beep found in the audio. Set the start time by hand in the app.\")\n    for tm in \"AB\":\n        if res[tm][\"finish\"] is None: lim.append(f\"Team {tm} boat never crossed the finish line in the clip.\")\n    lim.append(\"Touch detection looks for movement next to the boat; it can't see actual contact.\")\n    overlay = [dict(t=t, p=[[tm, round(boats[tm][k][\"x\"], 4), round(boats[tm][k][\"y\"], 4), round(boats[tm][k][\"w\"], 4), round(boats[tm][k][\"h\"], 4), 0] for tm in \"AB\" if boats[tm][k]], b=None) for k, t in enumerate(times)]\n    return F, dict(facts=dict(go=go, goSource=src, boats=res, fps=fps), events=events, limitations=lim, audio=dict(hasAudio=au[\"hasAudio\"], beeps=len(au[\"beeps\"]))), overlay\n\n\n# ---------------- al-karamah ----------------\ndef karamah(path, cfg, au, _):\n    F = Frames(path); fps = cfg.get(\"fps\", 6); objs = cfg[\"objects\"]; M = [matcher(o[\"color\"], cfg.get(\"tol\", 1)) for o in objs]\n    gob = next((b for b in au[\"beeps\"] if b[\"f\"] == 1760), None)\n    if cfg.get(\"startManual\") is not None: start, src = cfg[\"startManual\"], \"set by host\"\n    elif gob: start, src = gob[\"t\"], \"start beep heard in the audio\"\n    else: start, src = 0, \"start of the clip (no start beep heard)\"\n    times, frac = [], []\n    for t, fr in F.sample(fps):\n        times.append(t); P = planes(fr)\n        frac.append([[count_in(color_mask(P, M[i]), z[\"zone\"]) for z in objs] for i in range(len(objs))])\n    base = [[min(f[i][j] for f in frac[:3]) for j in range(len(objs))] for i in range(len(objs))]\n    placed = []\n    for i in range(len(objs)):\n        for j in range(len(objs)):\n            thr, run = max(.08, base[i][j] + .07), 0\n            for k in range(len(times)):\n                run = run + 1 if frac[k][i][j] > thr else 0\n                if run == 3:\n                    if times[k - 2] >= start - .3: placed.append(dict(obj=i, zone=j, t=times[k - 2], cov=frac[k][i][j]))\n                    break\n    placed.sort(key=lambda p: p[\"t\"]); events, correct, wrong = [], [], []\n    def ev(**e): events.append(dict(id=f\"e{len(events) + 1}\", status=\"ai\", **e))\n    for p in placed:\n        o, z = objs[p[\"obj\"]], objs[p[\"zone\"]]\n        if p[\"obj\"] == p[\"zone\"]: correct.append(p); ev(t=round(p[\"t\"], 2), type=\"placed_ok\", obj=o[\"id\"], conf=.85 if p[\"cov\"] > .2 else .6, reason=f\"{o['name']} colour filled {round(p['cov'] * 100)}% of its target spot\")\n        else: wrong.append(p); ev(t=round(p[\"t\"], 2), type=\"placed_wrong\", obj=o[\"id\"], zone=z[\"id\"], conf=.75 if p[\"cov\"] >